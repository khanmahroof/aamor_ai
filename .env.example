DATABASE_URL="file:./dev.db"
# npm run setup generates a secret when this is blank. Never commit real secrets.
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CONTEXT_SIZE=8192
MAX_OUTPUT_TOKENS=2048
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4.1-mini
ANTHROPIC_API_KEY=
# For cloud production set AI_DEFAULT_PROVIDER=groq. Keep the real key on the server.
GROQ_API_KEY=
# Optional comma-separated chat-model IDs, intersected with live Groq discovery.
GROQ_MODELS=
UPLOAD_DIR=storage/uploads
CHAT_RATE_LIMIT=20
CHAT_CONCURRENT_LIMIT=1
CHAT_TIMEOUT_MS=120000
MAX_UPLOAD_SIZE_MB=10
MAX_REQUEST_SIZE_KB=256
