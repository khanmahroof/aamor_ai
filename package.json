{
  "name": "aamor-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:db": "node --conditions=react-server --import tsx --test tests/database.test.ts",
    "db:generate": "prisma generate",
    "db:deploy": "npm run db:prepare && prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:migrate": "npm run db:prepare && prisma migrate dev",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "db:prepare": "tsx scripts/prepare-database.ts",
    "setup": "tsx scripts/setup.ts && npm run db:deploy && npm run db:generate",
    "test": "node --conditions=react-server --import tsx --test tests/auth.test.ts tests/chat.test.ts tests/database.test.ts tests/files.test.ts tests/providers.test.ts tests/groq.test.ts",
    "test:e2e": "node --import tsx --test tests/e2e.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.4",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-auth": "4.24.15",
    "pdf-parse": "2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
